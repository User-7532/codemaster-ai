{
  "name": "KnowledgeCard",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "description": "ap / osi / security / aws / cisco / cpp / python / global / business"
    },
    "topic": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "cloze",
        "written"
      ],
      "default": "cloze",
      "description": "cloze=\u7a74\u57cb\u3081 written=\u8a18\u8ff0"
    },
    "text": {
      "type": "string",
      "description": "\u7a74\u57cb\u3081\u306e\u6587\u7ae0\uff08\u7a7a\u6240\u306f ___\uff09\u307e\u305f\u306f\u8a18\u8ff0\u306e\u554f\u3044"
    },
    "answer": {
      "type": "string",
      "description": "\u7a7a\u6240\u306b\u5165\u308b\u8a9e\u53e5\uff08\u8a18\u8ff0\u3067\u306f\u8981\u70b9\uff09"
    },
    "model_answer": {
      "type": "string",
      "description": "\u8a18\u8ff0\u306e\u6a21\u7bc4\u89e3\u7b54"
    },
    "expected_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u8a18\u8ff0\u3067\u89e3\u7b54\u306b\u542b\u3081\u308b\u3079\u304d\u8981\u7d20\uff08\u63a1\u70b9\u306e\u89b3\u70b9\uff09"
    },
    "explanation": {
      "type": "string",
      "description": "\u5e73\u6613\u306a\u89e3\u8aac"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "seed",
        "chat",
        "ai"
      ],
      "description": "\u4f5c\u3089\u308c\u305f\u7531\u6765\u3002chat=\u30a2\u30b7\u30b9\u30bf\u30f3\u30c8\u3068\u306e\u4f1a\u8a71\u304b\u3089\u4f5c\u6210"
    }
  },
  "required": [
    "domain",
    "text",
    "answer"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  }
}