{
  "name": "TraceDrill",
  "properties": {
    "best_mistakes": {
      "type": "number"
    },
    "best_seconds": {
      "type": "number"
    },
    "code": {
      "description": "\u304a\u624b\u672c\u306e\u30b3\u30fc\u30c9",
      "type": "string"
    },
    "completions": {
      "default": 0,
      "type": "number"
    },
    "follow_up": {
      "description": "\u5199\u7d4c\u306e\u3042\u3068\u306b\u89e3\u304f\u7df4\u7fd2\u554f\u984c\uff08\u5b8c\u4e86\u6642\u306b Problem \u306b\u3059\u308b\uff09",
      "type": "object"
    },
    "goal": {
      "description": "\u5199\u7d4c\u3067\u8eab\u306b\u3064\u3051\u305f\u3044\u3053\u3068\uff08\u5165\u529b\u3055\u308c\u305f\u307e\u307e\uff09",
      "type": "string"
    },
    "history": {
      "items": {
        "properties": {
          "date": {
            "type": "string"
          },
          "mistakes": {
            "type": "number"
          },
          "mode": {
            "type": "string"
          },
          "peeks": {
            "type": "number"
          },
          "seconds": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "key_points": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "language": {
      "enum": [
        "cpp",
        "c",
        "python"
      ],
      "type": "string"
    },
    "last_done": {
      "type": "string"
    },
    "level": {
      "default": 0,
      "description": "\u89e3\u653e\u6e08\u307f\u306e\u6bb5\u968e 0=\u306a\u305e\u308a\u66f8\u304d 1=\u898b\u306a\u304c\u3089 2=\u96a0\u3057\u3066",
      "type": "number"
    },
    "line_notes": {
      "description": "\u884c\u3054\u3068\u306e\u89e3\u8aac\uff081\u59cb\u307e\u308a\u306e\u884c\u756a\u53f7\uff09",
      "items": {
        "properties": {
          "line": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "problem_id": {
      "description": "\u3053\u306e\u5199\u7d4c\u304b\u3089\u4f5c\u3063\u305f\u7df4\u7fd2\u554f\u984c",
      "type": "string"
    },
    "summary": {
      "description": "\u3053\u306e\u5199\u7d4c\u3067\u8eab\u306b\u3064\u304f\u3053\u3068",
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "goal",
    "language",
    "code"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}