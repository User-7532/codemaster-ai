{
  "name": "Submission",
  "type": "object",
  "properties": {
    "problem_id": {
      "type": "string"
    },
    "problem_title": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "correct",
        "partial",
        "wrong"
      ],
      "description": "AI\u5224\u5b9a\u306e\u7d50\u679c"
    },
    "score": {
      "type": "number",
      "description": "0-100\u70b9"
    },
    "time_complexity": {
      "type": "string"
    },
    "space_complexity": {
      "type": "string"
    },
    "test_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u30b3\u30fc\u30c9\u54c1\u8cea\u306e\u6307\u6458"
    },
    "explanation": {
      "type": "string",
      "description": "\u5e73\u6613\u306a\u8a00\u8449\u3067\u306e\u89e3\u8aac"
    },
    "interview_feedback": {
      "type": "string",
      "description": "\u9762\u63a5\u5b98\u76ee\u7dda\u306e\u8a55\u4fa1"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "practice",
        "interview",
        "review",
        "ai",
        "mixed"
      ]
    },
    "duration_seconds": {
      "type": "number"
    }
  },
  "required": [
    "problem_id",
    "verdict",
    "mode"
  ]
}