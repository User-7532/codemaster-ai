        "curriculum",
        "ai",
        "interview"
      ],
      "type": "string"
    },
    "stage": {
      "description": "\u30ab\u30ea\u30ad\u30e5\u30e9\u30e0\u6bb5\u968e 1=\u5b9a\u77f3 2=\u4f4e\u30ec\u30a4\u30e4\u30fc\u4e2d\u7d1a 3=\u5927\u578b\u30c6\u30c3\u30af\u7d1a",
      "type": "number"
    },
    "statement": {
